{
    "name": "k-neturen/yii2-firebird",
    "description": "Firebird connector for Yii2 framework",
    "keywords": ["yii2", "firebird", "active-record"],
    "type": "yii2-extension",
    "license": "BSD-3-Clause",
    "support": {
        "issues": "https://github.com/k-neturen/yii2-firebird/issues",
        "forum": "http://www.yiiframework.com/forum/",
        "wiki": "http://www.yiiframework.com/wiki/",
        "irc": "irc://irc.freenode.net/yii",
        "source": "https://github.com/k-neturen/yii2-firebird"
    },
    "authors": [
        {
            "name": "Neturen",
            "email": "k-neturen@gmail.com"
        }
    ],
    "require": {
        "php": ">=7.4",
        "ext-pdo": "*",
        "yiisoft/yii2": "~2.0.55"
    },
    "require-dev": {
        "yiisoft/yii2-dev": "~2.0.55",
        "yiisoft/yii2-coding-standards": "^3.0",
        "phpunit/phpunit": "^9.6",
        "dms/phpunit-arraysubset-asserts": "^0.5"
    },
    "autoload": {
        "psr-4": {
            "neturen\\db\\firebird\\": "src"
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
